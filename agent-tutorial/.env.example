# Copy to .env and fill in the two keys. Never commit .env.

# LLM provider (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# LangSmith tracing (AWS-hosted instance, AIDA workspace)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=730526ca-cf3b-4753-93d4-1f4d206acd38
LANGSMITH_PROJECT=agent-tutorial

# Any "provider:model" string supported by init_chat_model
MODEL=groq:openai/gpt-oss-120b
